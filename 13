async function searchT13(params) {
  params = t13ApplyParams(params || {});
  var keyword = t13Text(
    params.keyword || params.query || params.title || params.name
  );
  if (!keyword) return [];
  var page = t13Page(params.page);
  var url =
    T13_SITE +
    "/search.html?searchkey=" +
    encodeURIComponent(keyword) +
    "&page=" +
    page;
  var html = await t13GetText(url, T13_SITE + "/");
  return t13ParseCards(html, "");
}

async function loadDetail(source) {
  var value =
    source && typeof source === "object"
      ? source.link || source.externalUrl || source.id || ""
      : source;
  if (source && typeof source === "object") t13ApplyParams(source);
  var bookId = t13BookIdFromValue(value);
  if (!bookId) throw new Error("无法识别 13听书网书籍 ID");

  var detailURL = T13_SITE + "/youshengxiaoshuo/" + bookId + "/";
  var html = await t13GetText(detailURL, T13_SITE + "/");
  var title =
    t13StripTags(t13FirstMatch(html, /<h1\b[^>]*>([\s\S]*?)<\/h1>/i)) ||
    t13StripTags(t13FirstMatch(html, /<title\b[^>]*>([\s\S]*?)<\/title>/i))
      .replace(/有声小说.*$/i, "")
      .replace(/_13听书网.*$/i, "")
      .trim();
  if (!title) throw new Error("13听书网详情页解析失败");

  var imgTag = t13FirstMatch(html, /(<img\b[^>]*>)/i);
  var poster = t13Absolute(
    t13Attr(imgTag, "data-original") ||
      t13Attr(imgTag, "data-src") ||
      t13Attr(imgTag, "src")
  );
  var description = t13StripTags(
    t13FirstMatch(
      html,
      /<(?:div|p)\b[^>]*class="[^"]*(?:intro|desc|summary|content)[^"]*"[^>]*>([\s\S]*?)<\/(?:div|p)>/i
    )
  );

  var limit = t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS;
  var episodes = t13ParsePlayURLs(html, bookId).slice(0, limit);
  var publicEpisodes = episodes.map(function (episode, index) {
    return {
      id: episode.link,
      type: "url",
      title: episode.title,
      mediaType: "tv",
      episode: index + 1,
      link: episode.link,
      externalUrl: episode.link,
      description: episode.title
    };
  });

  return {
    id: detailURL,
    type: "url",
    title: title,
    originalTitle: title,
    description: description,
    releaseDate: "",
    posterPath: poster,
    detailPoster: poster,
    backdropPath: poster,
    backdropPaths: poster ? [poster] : [],
    coverUrl: poster,
    rating: 0,
    mediaType: "tv",
    genreTitle: "13听书网",
    genreItems: [],
    peoples: [],
    year: "",
    country: "",
    language: "国语",
    episodeCount: episodes.length,
    episodeItems: publicEpisodes,
    videoUrl: "",
    playerType: "",
    link: detailURL,
    externalUrl: detailURL,
    source: "13听书网",
    t13BookId: bookId
  };
}

async function loadResource(params) {
  params = t13ApplyParams(params || {});
  var candidates = [
    params.link,
    params.videoUrl,
    params.playUrl,
    params.url,
    params.externalUrl,
    params.id
  ];
  var raw = "";
  for (var index = 0; index < candidates.length; index += 1) {
    var value = candidates[index];
    if (value && typeof value === "object") {
      value = t13Text(value.link || value.videoUrl || value.externalUrl || value.id || value.url);
    } else {
      value = t13Text(value);
    }
    if (value) {
      raw = value;
      break;
    }
  }
  if (!raw) throw new Error("无法定位 13听书网播放章节");

  if (/^https?:\/\/[^\s]+\.(?:mp3|m4a|aac)(?:\?|$)/i.test(raw)) {
    return [
      {
        name: t13Text(params.title || params.name) || "13听书网音频",
        description: "来源：13听书网\n详情页直链",
        url: raw,
        playerType: "app"
      }
    ];
  }

  var pageURL = t13Absolute(raw);
  var html = await t13GetText(pageURL, T13_SITE + "/");
  var audioMatch =
    html.match(/(https?:\/\/[^\s"'<>]+\.(?:mp3|m4a|aac)(?:\?[^\s"'<>]*)?)/i) ||
    html.match(/["'](https?:\/\/[^"']*(?:audio|mp3|m4a|stream|play)[^"']*)["']/i);

  if (!audioMatch || !audioMatch[1]) {
    throw new Error("13听书网播放页未解析到有效音频地址");
  }

  return [
    {
      name: t13Text(params.title || params.name) || "13听书网音频",
      description: "来源：13听书网",
      url: t13DecodeEntities(audioMatch[1]),
      playerType: "app",
      source: "13听书网"
    }
  ];
}
