    var url =
      T13_SITE +
      "/search.html?searchkey=" +
      encodeURIComponent(keyword) +
      "&page=" +
      page;
    var html = await t13GetTextSafe(url, T13_SITE + "/");
    return t13ParseCards(html, "搜索");
  } catch (e) {
