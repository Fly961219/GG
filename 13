async function loadDetail(source) {
  var raw =
    source && typeof source === "object"
      ? source.link || source.externalUrl || source.id || ""
      : source;
  if (source && typeof source === "object") t13ApplyParams(source);
  var rawText = t13Text(raw).replace(/^ting13:/i, "");
  var bookId = t13BookIdFromUrl(rawText) || (/^\d+$/.test(rawText) ? rawText : "");
  var detailURL = bookId
    ? T13_SITE + "/youshengxiaoshuo/" + bookId + "/"
    : t13Absolute(rawText);

  var html = detailURL ? await t13GetTextSafe(detailURL, T13_SITE + "/") : "";
  var title =
    t13StripTags(t13FirstMatch(html, /<h1\b[^>]*>([\s\S]*?)<\/h1>/i)) ||
    t13StripTags(t13FirstMatch(html, /<title\b[^>]*>([\s\S]*?)<\/title>/i))
      .replace(/有声小说.*$/i, "")
      .replace(/_13听书网.*$/i, "")
      .trim() ||
    "13听书网有声书";

  var imgTag = t13FirstMatch(html, /(<img\b[^>]*>)/i);
  var poster = t13Absolute(
    t13Attr(imgTag, "data-original") ||
      t13Attr(imgTag, "data-src") ||
      t13Attr(imgTag, "src")
  );
  var backdrop = t13Image(poster);
  var description = t13StripTags(
    t13FirstMatch(
      html,
      /<(?:div|p)\b[^>]*class="[^"]*(?:intro|desc|summary|content)[^"]*"[^>]*>([\s\S]*?)<\/(?:div|p)>/i
    )
  );

  var limit = t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS;
  var episodes = t13ParseEpisodes(html, detailURL, bookId).slice(0, limit);

  return {
    id: detailURL || "ting13:detail",
    type: "url",
    title: title,
    originalTitle: title,
    description: description,
    releaseDate: "",
    posterPath: poster,
    detailPoster: poster,
    backdropPath: backdrop,
    backdropPaths: backdrop ? [backdrop] : [],
    coverUrl: backdrop || poster,
    rating: 0,
    mediaType: "tv",
    genreTitle: "13听书网",
    genreItems: [],
    peoples: [],
    year: "",
    country: "",
    language: "国语",
    episodeCount: episodes.length,
    episodeItems: episodes,
    videoUrl: "",
    playerType: "",
    link: detailURL,
    externalUrl: detailURL,
    source: "13听书网"
  };
}

async function loadResource(params) {
  try {
    t13ApplyParams(params || {});
    var candidates = [
      params.link,
      params.videoUrl,
      params.playUrl,
      params.url,
      params.externalUrl,
      params.id
    ];
    var raw = "";
    for (var i = 0; i < candidates.length; i += 1) {
      var val = candidates[i];
      if (val && typeof val === "object") {
        val = t13Text(val.link || val.videoUrl || val.externalUrl || val.id || val.url);
      } else {
        val = t13Text(val);
      }
      if (val) {
        raw = val;
        break;
      }
    }
    if (!raw) return [];

    if (/^https?:\/\/[^\s]+\.(?:mp3|m4a|aac|wav)(?:\?|$)/i.test(raw)) {
      return [
        {
          name: t13Text(params.title || params.name) || "13听书网音频",
          description: "来源：13听书网",
          url: raw,
          playerType: "app"
        }
      ];
    }

    var pageURL = t13Absolute(raw);
    var html = await t13GetTextSafe(pageURL, T13_SITE + "/");
    var audioMatch =
      html.match(/(https?:\/\/[^\s"'<>]+\.(?:mp3|m4a|aac)(?:\?[^\s"'<>]*)?)/i) ||
      html.match(/["'](https?:\/\/[^"']*(?:audio|mp3|m4a|stream|play)[^"']*)["']/i);

    if (!audioMatch || !audioMatch[1]) return [];

    return [
      {
        name: t13Text(params.title || params.name) || "13听书网音频",
        description: "来源：13听书网\n章节：" + pageURL,
        url: t13DecodeEntities(audioMatch[1]),
        playerType: "app",
        source: "13听书网"
      }
    ];
  } catch (e) {
    return [];
  }
}
