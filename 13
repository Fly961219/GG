function t13Text(value) {
  return value === null || value === undefined ? "" : String(value).trim();
}

function t13Page(value) {
  var page = parseInt(t13Text(value || 1), 10);
  if (!isFinite(page) || page < 1) page = 1;
  return Math.min(page, 5000);
}

function t13DecodeEntities(value) {
  return t13Text(value)
    .replace(/&#x([0-9a-f]+);/gi, function (_, hex) {
      return String.fromCharCode(parseInt(hex, 16));
    })
    .replace(/&#(\d+);/g, function (_, number) {
      return String.fromCharCode(parseInt(number, 10));
    })
    .replace(/&nbsp;/gi, " ")
    .replace(/&ensp;/gi, " ")
    .replace(/&emsp;/gi, " ")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&amp;/gi, "&");
}

function t13StripTags(value) {
  return t13DecodeEntities(
    t13Text(value)
      .replace(/<br\s*\/?>/gi, " ")
      .replace(/<script\b[\s\S]*?<\/script>/gi, " ")
      .replace(/<style\b[\s\S]*?<\/style>/gi, " ")
      .replace(/<[^>]+>/g, " ")
  )
    .replace(/\s+/g, " ")
    .trim();
}

function t13Attr(source, name) {
  var escaped = String(name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  var match = t13Text(source).match(
    new RegExp("\\b" + escaped + "\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))", "i")
  );
  if (!match) return "";
  return t13DecodeEntities(match[1] || match[2] || match[3] || "");
}

function t13FirstMatch(source, pattern) {
  var match = t13Text(source).match(pattern);
  return match ? match[1] || "" : "";
}

function t13Absolute(value) {
  var url = t13Text(value);
  if (!url) return "";
  if (/^https?:\/\//i.test(url)) return url;
  if (url.indexOf("//") === 0) return "https:" + url;
  if (url.charAt(0) === "/") return T13_SITE + url;
  return T13_SITE + "/" + url.replace(/^\.?\//, "");
}

function t13Image(value) {
  var url = t13Absolute(value);
  if (!url) return "";
  return T13_IMAGE_PROXY +
    "?url=" + encodeURIComponent(url.replace(/^https?:\/\//i, "")) +
    "&w=1280&h=720&fit=cover&output=webp&q=86";
}

function t13ApplyParams(params) {
  params = params || {};
  var limit = parseInt(
    t13Text(
      params.max_chapters !== undefined
        ? params.max_chapters
        : String(t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS)
    ),
    10
  );
  if (!isFinite(limit) || limit <= 0) {
    t13Runtime.maxChapters = T13_MAX_CHAPTERS;
  } else {
    t13Runtime.maxChapters = Math.max(
      T13_MIN_CHAPTERS,
      Math.min(T13_MAX_CHAPTERS, limit)
    );
  }
  return params;
}

function t13Headers(referer) {
  return {
    "User-Agent": T13_USER_AGENT,
    Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.6",
    Referer: t13Text(referer) || T13_SITE + "/"
  };
}

async function t13GetTextSafe(url, referer) {
  try {
    if (typeof Widget === "undefined" || !Widget.http || typeof Widget.http.get !== "function") {
      return "";
    }
    var response = await Widget.http.get(url, {
      headers: t13Headers(referer),
      timeout: T13_TIMEOUT
    });
    if (!response) return "";
    var data = response.data !== undefined ? response.data : response;
    if (typeof data === "string") return data;
    if (data && typeof data === "object") return JSON.stringify(data);
    return "";
  } catch (err) {
    return "";
  }
}

function t13BookIdFromUrl(rawUrl) {
  var match = t13Text(rawUrl).match(/\/youshengxiaoshuo\/(\d+)\/?/i);
  return match ? match[1] : "";
}

function t13BuildItem(detailURL, title, poster, author, intro, category) {
  var bookId = t13BookIdFromUrl(detailURL);
  var cleanTitle = t13StripTags(title)
    .replace(/有声小说.*$/i, "")
    .replace(/_13听书网.*$/i, "")
    .trim();
  if (!detailURL || !bookId || !cleanTitle || cleanTitle.length < 2) return null;
  if (/^(?:首页|分类|排行|搜索|登录|注册|更多|下一章|上一章|听书|有声)$/i.test(cleanTitle)) {
    return null;
  }
  var cleanPoster = t13Absolute(poster);
  var backdrop = t13Image(cleanPoster);
  var cleanAuthor = t13StripTags(author);
  var cleanIntro = t13StripTags(intro);
  return {
    id: "ting13:" + bookId,
    type: "url",
    title: cleanTitle,
    originalTitle: cleanTitle,
    description:
      cleanIntro ||
      [category, cleanAuthor ? "主播/作者：" + cleanAuthor : ""]
        .filter(Boolean)
        .join(" · "),
    posterPath: cleanPoster,
    detailPoster: cleanPoster,
    backdropPath: backdrop,
    backdropPaths: backdrop ? [backdrop] : [],
    coverUrl: backdrop || cleanPoster,
    rating: 0,
    mediaType: "tv",
    genreTitle: t13Text(category),
    year: "",
    country: "",
    language: "国语",
    link: detailURL,
    externalUrl: detailURL,
    source: "13听书网",
    t13BookId: bookId,
    t13Author: cleanAuthor
  };
}

function t13ParseCards(html, category) {
  var source = t13Text(html);
  if (!source) return [];
  var items = [];
  var seen = {};
  var aRegex = /<a\b([^>]*)>([\s\S]*?)<\/a>/gi;
  var match;

  while ((match = aRegex.exec(source))) {
    var attrs = match[1] || "";
    var href = t13Attr("<a " + attrs + ">", "href");
    if (!href) continue;
    var absURL = t13Absolute(href);
    var bookId = t13BookIdFromUrl(absURL);
    if (!bookId || seen[bookId]) continue;

    var tail = absURL.replace(/^https?:\/\/[^/]+\/youshengxiaoshuo\/\d+\/?/i, "");
    if (tail && tail !== "index.html") continue;

    var inner = match[2] || "";
    var imgInA = t13FirstMatch(inner, /(<img\b[^>]*>)/i);
    var poster = imgInA
      ? t13Attr(imgInA, "data-original") ||
        t13Attr(imgInA, "data-src") ||
        t13Attr(imgInA, "src")
      : "";
    var title =
      t13StripTags(inner) ||
      t13DecodeEntities(t13Attr("<a " + attrs + ">", "title")) ||
      t13Attr(imgInA, "alt");

    var ctxStart = Math.max(0, match.index - 200);
    var ctxEnd = Math.min(source.length, match.index + match[0].length + 400);
    var context = source.slice(ctxStart, ctxEnd);
    var author = t13FirstMatch(context, /(?:演播|作者|主播)[：:\s]*([^<\n/]+)/i);
    var intro = t13FirstMatch(
      context,
      /<(?:p|div)\b[^>]*class="[^"]*(?:intro|desc|summary|info)[^"]*"[^>]*>([\s\S]*?)<\/(?:p|div)>/i
    );

    var item = t13BuildItem(absURL, title, poster, author, intro, category);
    if (item) {
      seen[bookId] = true;
      items.push(item);
    }
  }

  return items;
}

function t13ParseEpisodes(html, detailURL, bookId) {
  var source = t13Text(html);
  if (!source) return [];
  var episodes = [];
  var seenUrl = {};
  var linkRegex = /<a\b[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi;
  var match;

  while ((match = linkRegex.exec(source))) {
    var href = t13Text(match[1]);
    if (!href || /^javascript:/i.test(href) || href === "#") continue;
    var absUrl = t13Absolute(href);
    if (absUrl === detailURL || seenUrl[absUrl]) continue;

    var isBookChapter =
      (bookId && absUrl.indexOf("/youshengxiaoshuo/" + bookId + "/") !== -1) ||
      /\/youshengxiaoshuo\/\d+\/[^/]+/i.test(absUrl);

    var label = t13StripTags(match[2]) || t13DecodeEntities(t13Attr(match[0], "title"));
    if (/^(?:首页|上一页|下一页|尾页|返回|分类|排行|搜索|登录|注册)$/i.test(label)) {
      continue;
    }

    if (isBookChapter) {
      seenUrl[absUrl] = true;
      episodes.push({
        id: absUrl,
        type: "url",
        title: label || "第" + (episodes.length + 1) + "集",
        mediaType: "tv",
        episode: episodes.length + 1,
        link: absUrl,
        externalUrl: absUrl,
        description: label || "第" + (episodes.length + 1) + "集"
      });
    }
  }

  return episodes;
}

