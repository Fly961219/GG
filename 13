async function searchTing13(params) {
  t13ApplyParams(params || {});
  var keyword = t13Text(
    params.keyword || params.query || params.title || params.name
  );
  if (!keyword) return [];
  var page = t13Page(params.page);
  // 若实际搜索路径不同，可替换为 13听书网站内搜索表单 action
  var url =
    T13_SITE +
    "/search.html?searchkey=" +
    encodeURIComponent(keyword) +
    "&page=" +
    page;
  var html = await t13GetText(url, T13_SITE + "/");
  return t13ParseCards(html, "搜索");
}

async function loadDetail(source) {
  var raw =
    source && typeof source === "object"
      ? source.link || source.externalUrl || source.id || ""
      : source;
  if (source && typeof source === "object") t13ApplyParams(source);
  var detailURL = t13Absolute(t13Text(raw).replace(/^ting13:/i, ""));
  if (!detailURL) throw new Error("无法识别 13听书网详情链接");

  var html = await t13GetText(detailURL, T13_SITE + "/");
  var title =
    t13StripTags(t13FirstMatch(html, /<h1\b[^>]*>([\s\S]*?)<\/h1>/i)) ||
    t13StripTags(t13FirstMatch(html, /<title\b[^>]*>([\s\S]*?)<\/title>/i)).split("_")[0];
  if (!title) throw new Error("13听书网详情页解析失败");

  var imgTag = t13FirstMatch(html, /(<img\b[^>]*>)/i);
  var poster = t13Absolute(
    t13Attr(imgTag, "data-original") ||
      t13Attr(imgTag, "data-src") ||
      t13Attr(imgTag, "src")
  );
  var backdrop = t13Image(poster);
  var description = t13StripTags(
    t13FirstMatch(
      html,
      /<(?:div|p)\b[^>]*class="[^"]*(?:intro|desc|summary|content)[^"]*"[^>]*>([\s\S]*?)<\/(?:div|p)>/i
    )
  );

  var limit = t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS;
  var episodes = t13ParseEpisodes(html, detailURL).slice(0, limit);

  return {
    id: detailURL,
    type: "url",
    title: title,
    originalTitle: title,
    description: description,
    releaseDate: "",
    posterPath: poster,
    detailPoster: poster,
    backdropPath: backdrop,
    backdropPaths: backdrop ? [backdrop] : [],
    coverUrl: backdrop || poster,
    rating: 0,
    mediaType: "tv",
    genreTitle: "13听书网",
    genreItems: [],
    peoples: [],
    year: "",
    country: "",
    language: "国语",
    episodeCount: episodes.length,
    episodeItems: episodes,
    videoUrl: "",
    playerType: "",
    link: detailURL,
    externalUrl: detailURL,
    source: "13听书网"
  };
}

async function loadResource(params) {
  t13ApplyParams(params || {});
  var candidates = [
    params.link,
    params.videoUrl,
    params.playUrl,
    params.url,
    params.externalUrl,
    params.id
  ];
  var raw = "";
  for (var i = 0; i < candidates.length; i += 1) {
    var val = candidates[i];
    if (val && typeof val === "object") {
      val = t13Text(val.link || val.videoUrl || val.externalUrl || val.id || val.url);
    } else {
      val = t13Text(val);
    }
    if (val) {
      raw = val;
      break;
    }
  }
  if (!raw) throw new Error("无法定位 13听书网播放章节");

  // 如果已经是可直接播放的音频链接
  if (/^https?:\/\/[^\s]+\.(?:mp3|m4a|aac|wav)(?:\?|$)/i.test(raw)) {
    return [
      {
        name: t13Text(params.title || params.name) || "13听书网音频",
        description: "来源：13听书网",
        url: raw,
        playerType: "app"
      }
    ];
  }

  var pageURL = t13Absolute(raw);
  var html = await t13GetText(pageURL, T13_SITE + "/");

  // 尝试从播放页 HTML 或内联脚本中提取音频直链
  var audioMatch =
    html.match(/(https?:\/\/[^\s"'<>]+\.(?:mp3|m4a|aac)(?:\?[^\s"'<>]*)?)/i) ||
    html.match(/["'](https?:\/\/[^"']*(?:audio|mp3|m4a|stream|play)[^"']*)["']/i);

  if (!audioMatch || !audioMatch[1]) {
    throw new Error("未在播放页中直接解析到音频地址，可能需要补充 13听书网异步播放接口");
  }

  var audioURL = t13DecodeEntities(audioMatch[1]);
  return [
    {
      name: t13Text(params.title || params.name) || "13听书网音频",
      description: "来源：13听书网\n章节：" + pageURL,
      url: audioURL,
      playerType: "app",
      source: "13听书网"
    }
  ];
}
