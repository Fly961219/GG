function t13Text(value) {
  return value === null || value === undefined ? "" : String(value).trim();
}

function t13Page(value) {
  var page = parseInt(t13Text(value || 1), 10);
  if (!isFinite(page) || page < 1) page = 1;
  return Math.min(page, 5000);
}

function t13DecodeEntities(value) {
  return t13Text(value)
    .replace(/&#x([0-9a-f]+);/gi, function (_, hex) {
      return String.fromCharCode(parseInt(hex, 16));
    })
    .replace(/&#(\d+);/g, function (_, number) {
      return String.fromCharCode(parseInt(number, 10));
    })
    .replace(/&nbsp;/gi, " ")
    .replace(/&ensp;/gi, " ")
    .replace(/&emsp;/gi, " ")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&amp;/gi, "&");
}

function t13StripTags(value) {
  return t13DecodeEntities(
    t13Text(value)
      .replace(/<br\s*\/?>/gi, " ")
      .replace(/<script\b[\s\S]*?<\/script>/gi, " ")
      .replace(/<style\b[\s\S]*?<\/style>/gi, " ")
      .replace(/<[^>]+>/g, " ")
  )
    .replace(/\s+/g, " ")
    .trim();
}

function t13Attr(source, name) {
  var escaped = String(name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  var match = t13Text(source).match(
    new RegExp("\\b" + escaped + "\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))", "i")
  );
  if (!match) return "";
  return t13DecodeEntities(match[1] || match[2] || match[3] || "");
}

function t13FirstMatch(source, pattern) {
  var match = t13Text(source).match(pattern);
  return match ? match[1] || "" : "";
}

function t13Absolute(value) {
  var url = t13Text(value);
  if (!url) return "";
  if (/^https?:\/\//i.test(url)) return url;
  if (url.indexOf("//") === 0) return "https:" + url;
  if (url.charAt(0) === "/") return T13_SITE + url;
  return T13_SITE + "/" + url.replace(/^\.?\//, "");
}

function t13ApplyParams(params) {
  params = params || {};
  var limit = parseInt(
    t13Text(
      params.max_chapters !== undefined
        ? params.max_chapters
        : String(t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS)
    ),
    10
  );
  if (!isFinite(limit) || limit <= 0) {
    t13Runtime.maxChapters = T13_MAX_CHAPTERS;
  } else {
    t13Runtime.maxChapters = Math.max(
      T13_MIN_CHAPTERS,
      Math.min(T13_MAX_CHAPTERS, limit)
    );
  }
  return params;
}

function t13Headers(referer) {
  return {
    "User-Agent": T13_USER_AGENT,
    Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.6",
    Referer: t13Text(referer) || T13_SITE + "/"
  };
}

function t13ResponseStatus(response) {
  return Number(
    (response && (response.statusCode || response.status || response.code)) || 200
  );
}

async function t13Request(url, referer, extraHeaders) {
  var headers = t13Headers(referer);
  extraHeaders = extraHeaders || {};
  Object.keys(extraHeaders).forEach(function (key) {
    headers[key] = extraHeaders[key];
  });
  var response = await Widget.http.get(url, {
    headers: headers,
    timeout: T13_TIMEOUT
  });
  var status = t13ResponseStatus(response);
  if (status < 200 || status >= 300) {
    throw new Error("13听书网 HTTP " + status + ": " + url);
  }
  return response && response.data !== undefined ? response.data : response;
}

async function t13GetText(url, referer) {
  var data = await t13Request(url, referer);
  return typeof data === "string" ? data : JSON.stringify(data || "");
}

function t13LooksLikeStatusOrCount(text) {
  var s = t13Text(text);
  if (!s) return true;
  return /^(?:连载|完结|全本|更新至|共\s*\d+|第?\s*\d+\s*[集章回期]|\d+(?:\.\d+)?\s*万字?|\d+\s*集)$/i.test(
    s
  );
}

function t13CleanTitle(raw) {
  var cleaned = t13StripTags(raw)
    .replace(/有声小说.*$/i, "")
    .replace(/_13听书网.*$/i, "")
    .replace(/^(?:连载|完结)\s*\d+(?:\.\d+)?\s*万?$/i, "")
    .trim();
  if (!cleaned || cleaned.length < 2 || t13LooksLikeStatusOrCount(cleaned)) {
    return "";
  }
  return cleaned;
}

function t13ParseCards(html, category) {
  var source = t13Text(html);
  var items = [];
  var byBookId = {};
  var marker = /href="([^"]*\/youshengxiaoshuo\/(\d+)\/?)"/gi;
  var match;

  while ((match = marker.exec(source))) {
    var bookId = match[2];
    if (!bookId) continue;

    var tagStart = source.lastIndexOf("<a", match.index);
    var tagEnd = source.indexOf(">", match.index);
    if (tagStart < 0 || tagEnd < 0) continue;
    var close = source.indexOf("</a>", tagEnd);
    if (close < 0) continue;

    var attrs = source.slice(tagStart, tagEnd);
    var inner = source.slice(tagEnd + 1, close);
    var imgTag = t13FirstMatch(inner, /(<img\b[^>]*>)/i);

    var poster = imgTag
      ? t13Absolute(
          t13Attr(imgTag, "data-original") ||
            t13Attr(imgTag, "data-src") ||
            t13Attr(imgTag, "src")
        )
      : "";

    var candidateTitle =
      t13CleanTitle(t13Attr(attrs, "title")) ||
      t13CleanTitle(t13Attr(imgTag, "alt")) ||
      t13CleanTitle(inner);

    if (!byBookId[bookId]) {
      var detailURL = T13_SITE + "/youshengxiaoshuo/" + bookId + "/";
      byBookId[bookId] = {
        id: "ting13:" + bookId,
        type: "url",
        title: candidateTitle || "有声书 " + bookId,
        originalTitle: candidateTitle || "有声书 " + bookId,
        description: category || "13听书网",
        posterPath: poster,
        detailPoster: poster,
        backdropPath: poster,
        backdropPaths: poster ? [poster] : [],
        coverUrl: poster,
        rating: 0,
        mediaType: "tv",
        genreTitle: t13Text(category),
        year: "",
        country: "",
        language: "国语",
        link: "ting13:" + bookId,
        externalUrl: detailURL,
        source: "13听书网",
        t13BookId: bookId
      };
      items.push(byBookId[bookId]);
    } else {
      // 同一本书出现多个 <a> 时，补全非状态类的真实书名和封面
      var existing = byBookId[bookId];
      if (
        candidateTitle &&
        (existing.title.indexOf("有声书 ") === 0 ||
          t13LooksLikeStatusOrCount(existing.title))
      ) {
        existing.title = candidateTitle;
        existing.originalTitle = candidateTitle;
      }
      if (poster && !existing.posterPath) {
        existing.posterPath = poster;
        existing.detailPoster = poster;
        existing.backdropPath = poster;
        existing.backdropPaths = [poster];
        existing.coverUrl = poster;
      }
    }

    marker.lastIndex = close + 4;
  }

  return items.filter(function (item) {
    return item.title && !t13LooksLikeStatusOrCount(item.title);
  });
}

function t13ParsePlayURLs(html, bookId) {
  var source = t13Text(html);
  var episodes = [];
  var byId = {};
  var marker = new RegExp(
    'href="([^"]*\\/youshengxiaoshuo\\/' + bookId + '\\/[^"]+)"',
    "gi"
  );
  var match;

  while ((match = marker.exec(source))) {
    var href = match[1];
    var absURL = t13Absolute(href);
    var tagStart = source.lastIndexOf("<a", match.index);
    var tagEnd = source.indexOf(">", match.index);
    if (tagStart < 0 || tagEnd < 0) continue;
    var close = source.indexOf("</a>", tagEnd);
    if (close < 0) continue;
    var attrs = source.slice(tagStart, tagEnd);
    var title =
      t13StripTags(source.slice(tagEnd + 1, close)) ||
      t13DecodeEntities(t13Attr(attrs, "title"));

    if (!byId[absURL]) {
      byId[absURL] = {
        url: absURL,
        title: title
      };
      episodes.push(byId[absURL]);
    } else if (title && title.length > t13Text(byId[absURL].title).length) {
      byId[absURL].title = title;
    }
    marker.lastIndex = close + 4;
  }

  return episodes.map(function (episode, index) {
    var title = t13Text(episode.title) || "第" + (index + 1) + "集";
    return {
      id: episode.url,
      type: "url",
      title: title,
      mediaType: "tv",
      episode: index + 1,
      link: episode.url,
      externalUrl: episode.url,
      description: title,
      source: "13听书网",
      t13BookId: bookId
    };
  });
}

function t13BookIdFromValue(value) {
  var raw = t13Text(value);
  var detail = raw.match(/\/youshengxiaoshuo\/(\d+)/i);
  if (detail) return detail[1];
  var own = raw.match(/^ting13:book:(\d+)$/i);
  if (own) return own[1];
  var shortOwn = raw.match(/^ting13:(\d+)$/i);
  if (shortOwn) return shortOwn[1];
  if (/^\d+$/.test(raw)) return raw;
  return "";
}

