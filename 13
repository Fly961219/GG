function t13Text(value) {
  return value === null || value === undefined ? "" : String(value).trim();
}

function t13Page(value) {
  var page = parseInt(t13Text(value || 1), 10);
  if (!isFinite(page) || page < 1) page = 1;
  return Math.min(page, 5000);
}

function t13DecodeEntities(value) {
  return t13Text(value)
    .replace(/&#x([0-9a-f]+);/gi, function (_, hex) {
      return String.fromCharCode(parseInt(hex, 16));
    })
    .replace(/&#(\d+);/g, function (_, number) {
      return String.fromCharCode(parseInt(number, 10));
    })
    .replace(/&nbsp;/gi, " ")
    .replace(/&ensp;/gi, " ")
    .replace(/&emsp;/gi, " ")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&amp;/gi, "&");
}

function t13StripTags(value) {
  return t13DecodeEntities(
    t13Text(value)
      .replace(/<br\s*\/?>/gi, " ")
      .replace(/<script\b[\s\S]*?<\/script>/gi, " ")
      .replace(/<style\b[\s\S]*?<\/style>/gi, " ")
      .replace(/<[^>]+>/g, " ")
  )
    .replace(/\s+/g, " ")
    .trim();
}

function t13Attr(source, name) {
  var escaped = String(name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  var match = t13Text(source).match(
    new RegExp("\\b" + escaped + "\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))", "i")
  );
  if (!match) return "";
  return t13DecodeEntities(match[1] || match[2] || match[3] || "");
}

function t13FirstMatch(source, pattern) {
  var match = t13Text(source).match(pattern);
  return match ? match[1] || "" : "";
}

function t13Absolute(value) {
  var url = t13Text(value);
  if (!url) return "";
  if (/^https?:\/\//i.test(url)) return url;
  if (url.indexOf("//") === 0) return "https:" + url;
  if (url.charAt(0) === "/") return T13_SITE + url;
  return T13_SITE + "/" + url.replace(/^\.?\//, "");
}

function t13Image(value) {
  var url = t13Absolute(value);
  if (!url) return "";
  return T13_IMAGE_PROXY +
    "?url=" + encodeURIComponent(url.replace(/^https?:\/\//i, "")) +
    "&w=1280&h=720&fit=cover&output=webp&q=86";
}

function t13ApplyParams(params) {
  params = params || {};
  var limit = parseInt(
    t13Text(
      params.max_chapters !== undefined
        ? params.max_chapters
        : String(t13Runtime.maxChapters || T13_DEFAULT_CHAPTERS)
    ),
    10
  );
  if (!isFinite(limit) || limit <= 0) {
    t13Runtime.maxChapters = T13_MAX_CHAPTERS;
  } else {
    t13Runtime.maxChapters = Math.max(
      T13_MIN_CHAPTERS,
      Math.min(T13_MAX_CHAPTERS, limit)
    );
  }
  return params;
}

function t13Headers(referer) {
  return {
    "User-Agent": T13_USER_AGENT,
    Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.6",
    Referer: t13Text(referer) || T13_SITE + "/"
  };
}

function t13ResponseStatus(response) {
  return Number(
    (response && (response.statusCode || response.status || response.code)) || 200
  );
}

async function t13Request(url, referer, extraHeaders) {
  var headers = t13Headers(referer);
  extraHeaders = extraHeaders || {};
  Object.keys(extraHeaders).forEach(function (key) {
    headers[key] = extraHeaders[key];
  });
  var response = await Widget.http.get(url, {
    headers: headers,
    timeout: T13_TIMEOUT
  });
  var status = t13ResponseStatus(response);
  if (status < 200 || status >= 300) {
    throw new Error("13听书网 HTTP " + status + ": " + url);
  }
  return response && response.data !== undefined ? response.data : response;
}

async function t13GetText(url, referer) {
  var data = await t13Request(url, referer);
  return typeof data === "string" ? data : JSON.stringify(data || "");
}

function t13NormalizeBookId(rawHref) {
  var cleaned = t13Text(rawHref)
    .replace(/^https?:\/\/[^/]+/i, "")
    .replace(/[?#].*$/, "")
    .replace(/^\/+|\/+$/g, "");
  return cleaned;
}

function t13ParseCards(html, category) {
  var source = t13Text(html);
  var items = [];
  var seen = {};

  // 优先按常见列表项容器切分；若结构不同则退化为按书籍详情链接提取
  var chunks = source.split(
    /<(?:li|div)\b[^>]*class="[^"]*(?:book[-_]?item|list[-_]?item|item|card|row)[^"]*"[^>]*>/i
  );

  if (chunks.length > 1) {
    for (var i = 1; i < chunks.length; i += 1) {
      var block = chunks[i];
      var linkMatch = block.match(
        /href="([^"]*(?:\/book\/|\/yousheng\/|\/ting\/|\/show\/|\/detail\/)[^"]*)"/i
      );
      if (!linkMatch) continue;
      var detailURL = t13Absolute(linkMatch[1]);
      var bookKey = t13NormalizeBookId(linkMatch[1]);
      if (!bookKey || seen[bookKey]) continue;

      var title =
        t13StripTags(
          t13FirstMatch(block, /<a\b[^>]*href="[^"]*"[^>]*>([\s\S]*?)<\/a>/i)
        ) || t13DecodeEntities(t13Attr(linkMatch[0], "title"));
      if (!title || title.length < 1) continue;

      seen[bookKey] = true;
      var imgTag = t13FirstMatch(block, /(<img\b[^>]*>)/i);
      var poster = t13Absolute(
        t13Attr(imgTag, "data-original") ||
          t13Attr(imgTag, "data-src") ||
          t13Attr(imgTag, "src")
      );
      var author = t13StripTags(
        t13FirstMatch(block, /(?:作者|播音|主播)[：:\s]*([^<\n/]+)/i)
      );
      var intro = t13StripTags(
        t13FirstMatch(block, /<(?:p|div)\b[^>]*class="[^"]*(?:intro|desc|summary|info)[^"]*"[^>]*>([\s\S]*?)<\/(?:p|div)>/i)
      );
      var backdrop = t13Image(poster);

      items.push({
        id: "ting13:" + bookKey,
        type: "url",
        title: title,
        originalTitle: title,
        description:
          intro ||
          [category, author ? "主播/作者：" + author : ""]
            .filter(Boolean)
            .join(" · "),
        posterPath: poster,
        detailPoster: poster,
        backdropPath: backdrop,
        backdropPaths: backdrop ? [backdrop] : [],
        coverUrl: backdrop || poster,
        rating: 0,
        mediaType: "tv",
        genreTitle: t13Text(category),
        year: "",
        country: "",
        language: "国语",
        link: detailURL,
        externalUrl: detailURL,
        source: "13听书网",
        t13BookKey: bookKey,
        t13Author: author
      });
    }
  }

  return items;
}

function t13ParseEpisodes(html, detailURL) {
  var source = t13Text(html);
  var episodes = [];
  var seenUrl = {};
  var linkRegex = /<a\b[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi;
  var match;

  while ((match = linkRegex.exec(source))) {
    var href = t13Text(match[1]);
    var label = t13StripTags(match[2]) || t13DecodeEntities(t13Attr(match[0], "title"));
    // 过滤明显非章节的导航/分页/标签链接
    if (!href || /^javascript:/i.test(href) || href === "#") continue;
    if (/^(?:首页|上一页|下一页|尾页|返回|分类|排行|搜索|登录|注册)$/i.test(label)) {
      continue;
    }
    var absUrl = t13Absolute(href);
    if (absUrl === detailURL || seenUrl[absUrl]) continue;
    // 常见章节链接特征（数字/集/章/play/ting/read）
    if (/(?:第?\s*\d+\s*[集章回期]|play|ting|chapter|ep|\d+\.html?)/i.test(label + " " + href)) {
      seenUrl[absUrl] = true;
      episodes.push({
        id: absUrl,
        type: "url",
        title: label || "第" + (episodes.length + 1) + "集",
        mediaType: "tv",
        episode: episodes.length + 1,
        link: absUrl,
        externalUrl: absUrl,
        description: label || "第" + (episodes.length + 1) + "集"
      });
    }
  }

  return episodes;
}

